{
  "manifest_version": 3,
  "name": "ArgoCD UI Enhancer",
  "version": "0.3.1",
  "description": "Filter ArgoCD resource tree by kind, keeping children of the selected kind. Add your own ArgoCD host from the toolbar popup.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ArgoCD UI Enhancer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*"]
}
